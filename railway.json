{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "config": {
      "BUILD_ARR": "npm run install:all && npm run build",
      "START_CMD": "cd server && node server.js",
      "NODE_ARR": "18"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd server && node server.js"
  }
}